{
  "manifest_version": 3,
  "name": "안심스캔 — 아이 먹거리 점수",
  "version": "0.1.0",
  "description": "쇼핑몰 식품 상세 페이지에서 원재료를 읽어 아이 기준 안심점수와 같은 몰의 더 나은 대체품을 보여줍니다.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.coupang.com/vp/products/*",
        "https://smartstore.naver.com/*/products/*",
        "https://brand.naver.com/*/products/*",
        "https://www.kurly.com/goods/*",
        "https://www.ssg.com/item/*",
        "https://www.11st.co.kr/products/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core/*.js", "data/sample-catalog.json"],
      "matches": [
        "https://www.coupang.com/*",
        "https://smartstore.naver.com/*",
        "https://brand.naver.com/*",
        "https://www.kurly.com/*",
        "https://www.ssg.com/*",
        "https://www.11st.co.kr/*"
      ]
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "안심스캔 설정", "default_popup": "options.html" }
}
